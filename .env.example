# docker-compose.yml автоматически подхватывает этот файл, если скопировать его в .env
# Порт на хосте (внутри контейнера приложение всегда слушает 3000)
APP_PORT=8080

# Время жизни кэша погоды в миллисекундах (по умолчанию 10 минут)
CACHE_TTL_MS=600000

# Только для локального запуска без Docker
PORT=3000
